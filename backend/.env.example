# Interview-Copilot Backend Configuration

# Required: Set your LLM API Key (OpenAI / DeepSeek / Qwen / Moonshot / SiliconFlow / etc.)
# 必须填写真实密钥。留空（或保留占位值）时模型调用会直接返回明确错误，
# 不会再降级成示例数据。
LLM_API_KEY=

# Optional: Base URL for OpenAI-compatible providers
# For DeepSeek: https://api.deepseek.com
# For SiliconFlow: https://api.siliconflow.cn/v1
# For Ollama: http://localhost:11434/v1
# For Moonshot: https://api.moonshot.cn/v1
# LLM_BASE_URL=https://api.deepseek.com

# LLM Model Name
LLM_MODEL=gpt-4o

# Temperature
LLM_TEMPERATURE=0.7

# Optional server-side Tavily key for real web search.
# Users can alternatively configure a browser-local key from the UI.
TAVILY_API_KEY=

# Database (SQLite by default, or postgresql+asyncpg://user:pass@localhost:5432/interview_copilot)
# 注意：sqlite 为相对路径时一律锚定到 backend/ 目录，与启动服务时的工作目录无关；
# PERSONA_DATA_DIR 等相对目录同理。填绝对路径则按原样使用。
DATABASE_URL=sqlite+aiosqlite:///./interview_copilot.db

# Personas (自建面试官存储目录：每个角色一个独立 JSON 文件)
PERSONA_DATA_DIR=./data/personas
